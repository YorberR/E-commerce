# Preferred: a single SQLAlchemy URL. Overrides the DB_* variables below.
# Examples:
#   postgresql+psycopg2://user:password@localhost:5432/ecommerce
#   mysql+pymysql://user:password@localhost:3306/ecommerce?charset=utf8mb4
DATABASE_URL=

# Optional DDL URL for Alembic. Use a migration user; falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=

# Fallback used only when DATABASE_URL is empty.
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
